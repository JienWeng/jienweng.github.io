  "narrative": {
    "northStar": "Practical Editorial Portfolio",
    "overview": "The homepage uses a confident editorial composition: oversized type, warm paper, charcoal rules, and rust numbered work rails. Practical evidence and direct navigation carry the professional identity. The same Archivo, warm paper, charcoal, and rust identity extends across template-based content and collection pages. Standalone slide decks retain their own designs.\n\nThe approved visual reference is `.impeccable/mocks/desktop-recommended.png`, with the headline \u201cBusiness needs. Buildable products.\u201d Implementation sources are `templates/base.html`, `templates/partials/portfolio-header.html`, `templates/home.html`, `templates/page.html`, `static/site.css`, `static/portfolio.css`, and `static/portfolio.js`. The base template preloads Archivo and loads the shared portfolio CSS and menu script on every template-based page.",
    "keyCharacteristics": [
      "Oversized, tightly set sans-serif display type.",
      "Flat paper surfaces, thin rules, and square corners.",
      "Numbered rust rails paired with work evidence.",
      "Responsive semantic diagrams and direct text links."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Color organizes the reading sequence; evidence remains understandable without color.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve visible keyboard focus and the 44px minimum for primary actions and disclosure controls.",
      "Do label the payment workflow as illustrative and retain provenance for the restyled CRM workflow.",
      "Do retain the native mobile menu and reduced-motion behavior.",
      "Do use the shared Archivo identity across template pages and preserve standalone slide designs.",
      "Do make each label and sentence explain a destination, role, decision, or piece of evidence."
    ],
    "donts": [
      "Don't introduce shadows, rounded card grids, or decorative technology imagery across template pages.",
      "Don't present illustrative workflows as product screenshots.",
      "Don't treat this documentation as a passed formal quantitative build-state specification."
    ]
  }
